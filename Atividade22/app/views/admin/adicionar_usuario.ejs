<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <title>Cadastro de Usuários</title> </head>

<body>
    <h1>Adicionar Usuário</h1> <form action="/usuario/salvar" method="post"> <label>Nome</label>
        <input type="text" id="nome" name="nome_usuario" placeholder="Nome do Usuário" required/> <br />
        <br />
        <label>E-mail</label>
        <input type="email" id="email" name="email_usuario" placeholder="E-mail do Usuário" required/> <br />
        <br />
        <label>Senha</label>
        <input type="password" id="senha" name="senha_usuario" placeholder="Senha" required/> <br />
        <br />
        <input type="submit" value="Salvar" /> </form>
</body>
</html>