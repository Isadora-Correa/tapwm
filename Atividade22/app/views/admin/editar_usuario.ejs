<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <title>Edição de Usuário</title> </head>

<body>
    <h1>Editar Usuário</h1> <p>ID: <%= users[0].ID_USUARIO %>
    </p>
    <p>NOME: <%= users[0].NOME_USUARIO %>
    </p>
    <p>EMAIL: <%= users[0].EMAIL_USUARIO %>
    </p>

    <form action="/usuario/editar" method="post"> <input type="hidden" id="id_usuario" name="id_usuario" value="<%= users[0].ID_USUARIO %>" />

        <label>Nome</label>
        <input type="text" id="nome" name="nome_usuario" placeholder="Novo nome" value="<%= users[0].NOME_USUARIO %>" required/> <br />
        <br />
        <label>E-mail</label>
        <input type="email" id="email" name="email_usuario" placeholder="Novo e-mail" value="<%= users[0].EMAIL_USUARIO %>" required/> <br />
        <br />
        <label>Nova Senha</label>
        <input type="password" id="senha" name="senha_usuario" placeholder="Digite a nova senha (deixe em branco para não alterar)" /> <br />
        <br />
        <input type="submit" value="Salvar Alterações" /> </form>

</body>
</html>